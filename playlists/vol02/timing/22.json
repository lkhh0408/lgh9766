[
 {
  "line": "White chalk line on a green tabletop",
  "section": "Verse",
  "start": 4.3,
  "end": 7.3,
  "estimated": true
 },
 {
  "line": "Two red paddles from the corner shop",
  "section": "Verse",
  "start": 8.59,
  "end": 11.59,
  "estimated": true
 },
 {
  "line": "You bounce the ball on the back of your hand",
  "section": "Verse",
  "start": 12.89,
  "end": 15.89,
  "estimated": true
 },
 {
  "line": "I ask the rules and you say, “You’ll see”",
  "section": "Verse",
  "start": 17.19,
  "end": 20.19,
  "estimated": true
 },
 {
  "line": "It clips the net, comes down on your side",
  "section": "Verse",
  "start": 21.49,
  "end": 24.49,
  "estimated": true
 },
 {
  "line": "You scoop it up, send it shoulder-high",
  "section": "Verse",
