 },
 {
  "line": "Meet me on the other side of seven",
  "section": "Chorus",
  "start": 58.18,
  "end": 60.46
 },
 {
  "line": "Where your answer crosses mine",
  "section": "Chorus",
  "start": 60.46,
  "end": 63.94
 },
 {
  "line": "You know the moons around a planet",
  "section": "Verse",
  "start": 67.52,
  "end": 70.0
 },
 {
  "line": "I know the words to movie themes",
  "section": "Verse",
  "start": 71.42,
  "end": 74.62
 },
 {
  "line": "You take the ones about the Romans",
  "section": "Verse",
  "start": 75.92,
  "end": 78.48
 },
 {
  "line": "Leave all the leading ladies to me",
  "section": "Verse",
  "start": 78.48,
  "end": 83.04
 },
 {
  "line": "Four down is asking for a singer",
  "section": "Verse",
  "start": 84.36,
  "end": 86.9
 },
 {
  "line": "You hum two bars, I write her name",
  "section": "Verse",
  "start": 86.9,
  "end": 91.06
 },
 {
  "line": "The waitress tops us up and whispers,",
  "section": "Verse",
  "start": 92.38,
  "end": 95.46
 },
 {
  "line": "“My mother plays that song most days”",
  "section": "Verse",
  "start": 95.46,
  "end": 99.6
 },
 {
  "line": "One square left",
