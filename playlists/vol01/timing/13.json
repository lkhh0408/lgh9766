  "start": 104.84,
  "end": 106.76
 },
 {
  "line": "We’ve got this one",
  "section": "Turnaround",
  "start": 106.76,
  "end": 109.12
 },
 {
  "line": "Of all the things I know about you",
  "section": "Bridge",
  "start": 109.12,
  "end": 113.34
 },
 {
  "line": "My favorite might be this",
  "section": "Bridge",
  "start": 113.34,
  "end": 116.5
 },
 {
  "line": "You do the whole thing in blue pencil",
  "section": "Bridge",
  "start": 116.5,
  "end": 120.54
 },
 {
  "line": "Then date it like a work of art",
  "section": "Bridge",
  "start": 120.54,
  "end": 124.38
 },
 {
  "line": "I used to toss the Sunday paper",
  "section": "Bridge",
  "start": 124.38,
  "end": 127.86
 },
 {
  "line": "Now there’s a stack beneath my bed",
  "section": "Bridge",
  "start": 127.86,
  "end": 129.8
 },
 {
  "line": "A hundred mornings in your handwriting",
  "section": "Bridge",
  "start": 129.8,
  "end": 132.26
 },
 {
  "line": "With half the words in mine",
  "section": "Bridge",
  "start": 132.5,
