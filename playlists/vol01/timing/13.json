[
 {
  "line": "Six letters for a bird at sea",
  "section": "Verse",
  "start": 9.34,
  "end": 11.9
 },
 {
  "line": "Your pencil drums against your knee",
  "section": "Verse",
  "start": 11.9,
  "end": 15.88
 },
 {
  "line": "I say, “A puffin.” You count twice",
  "section": "Verse",
  "start": 15.88,
  "end": 19.26
 },
 {
  "line": "It fits. We like that. Pass the ice.",
  "section": "Verse",
  "start": 19.26,
  "end": 23.52
 },
 {
  "line": "Your coffee sweats a perfect O",
  "section": "Verse",
  "start": 24.94,
  "end": 28.06
 },
 {
  "line": "Around a clue we almost know",
  "section": "Verse",
  "start": 29.38,
  "end": 32.42
 },
 {
  "line": "We’ve got a booth, a pen that works",
  "section": "Verse",
  "start": 32.42,
  "end": 36.06
 },
 {
  "line": "And Sunday in our hands",
