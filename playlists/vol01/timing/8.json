 {
  "line": "Like we've done this all before",
  "section": "Pre-Chorus",
  "start": 35.62,
  "end": 38.14
 },
 {
  "line": "Then she asks about next weekend",
  "section": "Pre-Chorus",
  "start": 39.1,
  "end": 40.9
 },
 {
  "line": "And I say, “I'll be here for sure”",
