  "start": 41.04,
  "end": 43.6
 },
 {
  "line": "We're on a first-name basis",
  "section": "Chorus",
  "start": 43.6,
  "end": 46.36
 },
 {
  "line": "Saving each other spaces",
  "section": "Chorus",
  "start": 46.36,
  "end": 48.96
 },
 {
  "line": "A “see you soon” already",
