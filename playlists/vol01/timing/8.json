[
 {
  "line": "Saturday, a quarter after nine",
  "section": "Verse",
  "start": 3.1,
  "end": 6.16
 },
 {
  "line": "Rolled-up mat and a painted wooden sign",
  "section": "Verse",
  "start": 9.48,
  "end": 11.48
 },
 {
  "line": "Through the courtyard, up a flight of stairs",
  "section": "Verse",
  "start": 11.48,
  "end": 15.64
 },
 {
  "line": "Someone waves me to a place beside theirs",
  "section": "Verse",
  "start": 16.64,
  "end": 20.72
 },
 {
  "line": "She says, “I'm June,” I tell her my name",
  "section": "Verse",
  "start": 21.62,
  "end": 24.88
 },
 {
  "line": "We reach for our toes and laugh the same",
  "section": "Verse",
  "start": 24.88,
  "end": 27.48
 },
 {
  "line": "Teacher opens up the balcony doors",
  "section": "Verse",
  "start": 27.48,
  "end": 30.42
 },
 {
  "line": "Morning air moves across the floor",
  "section": "Verse",
  "start": 30.42,
  "end": 32.84
 },
 {
  "line": "By the second stretch, we're talking",
