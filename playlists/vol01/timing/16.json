[
 {
  "line": "On the way to the morning market",
  "section": "Verse",
  "start": 8.86,
  "end": 12.08
 },
 {
  "line": "I practice asking for a pear",
  "section": "Verse",
  "start": 12.38,
  "end": 13.94
 },
 {
  "line": "My little book falls open",
  "section": "Verse",
  "start": 14.2,
  "end": 16.26
 },
 {
  "line": "To a picture of one right there",
  "section": "Verse",
  "start": 16.7,
  "end": 19.06
 },
 {
  "line": "I know the word for yellow",
  "section": "Verse",
  "start": 19.06,
  "end": 21.02
 },
 {
  "line": "I know the word for green",
  "section": "Verse",
  "start": 21.58,
  "end": 23.38
 },
 {
  "line": "The woman in the apron",
  "section": "Verse",
  "start": 23.38,
  "end": 25.8
 },
 {
  "line": "Holds one out for me",
  "section": "Verse",
  "start": 25.8,
  "end": 28.12
 },
 {
  "line": "She asks me, “For today?”",
  "section": "Pre-Chorus",
  "start": 28.12,
  "end": 31.82
 },
 {
  "line": "I close the book and say",
  "section": "Pre-Chorus",
  "start": 33.07,
  "end": 36.86
 },
 {
  "line": "One for today, one for tomorrow",
  "section": "Chorus",
  "start": 37.07,
  "end": 41.56
 },
 {
  "line": "She picks them out, I watch her hands",
  "section": "Chorus",
  "start": 42.21,
  "end": 46.3
 },
 {
  "line": "One for today, one for tomorrow",
  "section": "Chorus",
  "start": 46.3,
  "end": 51.28
 },
 {
  "line": "She smiles at me, she understands",
  "section": "Chorus",
  "start": 51.28,
  "end": 55.64
 },
 {
  "line": "The words come off the page",
  "section": "Chorus",
  "start": 55.64,
  "end": 60.08
 },
 {
  "line": "And just like that, we’re talking",
  "section": "Chorus",
  "start": 60.96,
  "end": 63.62
 },
 {
  "line": "She taps the softer pear and says",
  "section": "Verse",
  "start": 67.38,
  "end": 70.16
 },
 {
  "line": "“This one’s ready when you are”",
  "section": "Verse",
  "start": 70.16,
  "end": 72.46
 },
 {
  "line": "We eat it leaning on the counter",
  "section": "Verse",
  "start": 77.12,
  "end": 79.98
 },
 {
  "line": "With juice all down my arm",
  "section": "Verse",
  "start": 79.98,
  "end": 82.9
 },
 {
  "line": "I tell her where I come from",
  "section": "Verse",
  "start": 84.98,
  "end": 87.78
 },
 {
  "line": "She asks what grows back home",
  "section": "Verse",
  "start": 87.78,
  "end": 89.74
 },
 {
  "line": "I draw a peach with my fingertip",
  "section": "Verse",
  "start": 89.74,
  "end": 92.36
 },
 {
  "line": "She says the word real slow",
  "section": "Verse",
  "start": 92.36,
  "end": 94.26
 },
 {
  "line": "All week I’d read both parts aloud",
  "section": "Bridge",
  "start": 124.26,
  "end": 126.26
 },
 {
  "line": "The shopkeeper, the guest",
  "section": "Bridge",
  "start": 126.26,
  "end": 130.78
 },
 {
  "line": "Turns out my favorite part is this",
  "section": "Bridge",
  "start": 130.78,
  "end": 136.08
 },
 {
  "line": "She gets to say what happens next",
  "section": "Bridge",
  "start": 136.08,
  "end": 141.24
 },
 {
  "line": "One for today, one for tomorrow",
  "section": "Final Chorus",
  "start": 142.6,
  "end": 147.8
 },
 {
  "line": "She folds the paper round the green",
  "section": "Final Chorus",
  "start": 147.8,
  "end": 152.44
 },
 {
  "line": "One for today, one for tomorrow",
  "section": "Final Chorus",
  "start": 152.44,
  "end": 157.48
 },
 {
  "line": "Now I know just what she means",
  "section": "Final Chorus",
  "start": 158.28,
  "end": 162.24
 },
 {
  "line": "The words come off the page",
  "section": "Final Chorus",
  "start": 162.24,
  "end": 166.24
 },
 {
  "line": "She’s waving as I’m walking",
  "section": "Final Chorus",
  "start": 167.26,
  "end": 170.32
 },
 {
  "line": "A pear inside my pocket",
  "section": "Outro",
  "start": 172.1,
  "end": 174.68
 },
 {
  "line": "A word for peach to keep",
  "section": "Outro",
  "start": 176.9,
  "end": 179.38
 },
 {
  "line": "I say it all the way back home",
  "section": "Outro",
  "start": 180.88,
  "end": 184.84
 },
 {
  "line": "It sounds a little more like me",
  "section": "Outro",
  "start": 185.16,
  "end": 189.38
 }
]