[
 {
  "line": "Halfway through a movie trailer",
  "section": "Verse",
  "start": 1.84,
  "end": 5.06
 },
 {
  "line": "There’s a line you’d say out loud",
  "section": "Verse",
  "start": 5.06,
  "end": 9.48
 },
 {
  "line": "I turn to tell you, then remember",
  "section": "Verse",
  "start": 10.0,
  "end": 14.0
 },
 {
  "line": "You’re three train stops from my couch",
