[
 {
  "line": "I pick a flat stone off the bank",
  "section": "Verse",
  "start": 0.0,
  "end": 12.86
 },
 {
  "line": "It sits in the crook of my hand",
  "section": "Verse",
  "start": 12.86,
  "end": 17.88
 },
 {
  "line": "One side’s warm from the sun",
  "section": "Verse",
  "start": 17.88,
  "end": 21.28
 },
 {
  "line": "One side’s cool from the sand",
  "section": "Verse",
  "start": 21.28,
  "end": 27.26
 },
 {
  "line": "I bend down low and let it slide",
  "section": "Verse",
  "start": 29.74,
  "end": 31.7
 },
 {
  "line": "So close to the water it seems",
  "section": "Verse",
  "start": 31.7,
  "end": 35.08
 },
 {
  "line": "For half a breath to be standing still",
  "section": "Verse",
  "start": 37.63,
  "end": 41.0
 },
 {
  "line": "Then it skips out of reach",
  "section": "Verse",
  "start": 41.0,
  "end": 44.46
 },
 {
  "line": "One, two, three, still going",
  "section": "Chorus",
  "start": 46.26,
  "end": 49.56
 },
 {
  "line": "Four, five, would you look at that?",
  "section": "Chorus",
  "start": 49.56,
  "end": 51.62
 },
 {
  "line": "Six, and the water opens",
  "section": "Chorus",
  "start": 52.14,
  "end": 54.58
 },
 {
  "line": "Seven rings where the stone went flat",
  "section": "Chorus",
  "start": 55.14,
  "end": 57.16
 },
 {
  "line": "I like the part after letting go",
  "section": "Chorus",
  "start": 57.16,
  "end": 60.44
 },
 {
  "line": "When I’ve done all I can do",
  "section": "Chorus",
  "start": 60.96,
  "end": 62.9
 },
 {
  "line": "And it’s still going",
  "section": "Chorus",
  "start": 62.9,
  "end": 65.22
 },
 {
  "line": "Still going",
  "section": "Chorus",
  "start": 68.16,
  "end": 69.68
 },
 {
  "line": "I find a white one shaped like a dime",
  "section": "Verse",
  "start": 73.2,
  "end": 76.26
 },
 {
  "line": "Turn it twice in my palm",
  "section": "Verse",
  "start": 76.26,
  "end": 78.8
 },
 {
  "line": "It takes one hop, then settles in",
  "section": "Verse",
  "start": 81.62,
  "end": 86.48
 },
 {
  "line": "And the circles travel on",
  "section": "Verse",
  "start": 86.48,
  "end": 91.38
 },
 {
  "line": "They touch a leaf along the edge",
  "section": "Verse",
  "start": 92.8,
  "end": 96.04
 },
 {
  "line": "It lifts, then settles too",
  "section": "Verse",
  "start": 96.72,
  "end": 99.06
 },
 {
  "line": "I came down here to count the skips",
  "section": "Verse",
  "start": 101.2,
  "end": 105.56
 },
 {
  "line": "Now I’m counting what they move",
  "section": "Verse",
  "start": 105.56,
  "end": 108.32
 },
 {
  "line": "I lie back on the wooden dock",
  "section": "Bridge",
  "start": 131.7,
  "end": 136.48
 },
 {
  "line": "One arm hanging off the side",
  "section": "Bridge",
  "start": 136.48,
  "end": 140.48
 },
 {
  "line": "A ripple taps my fingertips",
  "section": "Bridge",
  "start": 142.7,
  "end": 145.88
 },
 {
  "line": "I know that one was mine",
  "section": "Bridge",
  "start": 145.88,
  "end": 150.62
 },
 {
  "line": "One, two, three, still going",
  "section": "Final Chorus",
  "start": 150.62,
  "end": 155.1
 },
 {
  "line": "I leave the numbers there",
  "section": "Final Chorus",
  "start": 155.1,
  "end": 157.2
 },
 {
  "line": "A reed leans into its reflection",
  "section": "Final Chorus",
  "start": 157.2,
  "end": 159.94
 },
 {
  "line": "And draws it back again",
  "section": "Final Chorus",
