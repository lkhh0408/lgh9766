[
 {
  "line": "Milo drops a record in my crate",
  "section": "Verse",
  "start": 3.22,
  "end": 5.34
 },
 {
  "line": "Says, “Side B, track three, just wait”",
  "section": "Verse",
  "start": 5.34,
  "end": 10.6
 },
 {
  "line": "On the sleeve, three men in suits",
  "section": "Verse",
  "start": 12.2,
  "end": 14.76
 },
 {
  "line": "One in a pair of silver boots",
  "section": "Verse",
  "start": 14.76,
  "end": 17.5
 },
 {
  "line": "I’ve got a ten. It’s marked at five",
  "section": "Verse",
  "start": 17.5,
  "end": 21.9
 },
 {
  "line": "The shop’s been open since a quarter to nine",
  "section": "Verse",
  "start": 21.9,
  "end": 27.58
 },
 {
  "line": "He sets the needle in the groove",
  "section": "Verse",
  "start": 27.58,
  "end": 31.46
 },
 {
  "line": "I’m halfway sold by bar two",
  "section": "Verse",
  "start": 31.46,
  "end": 33.8
 },
 {
  "line": "Spin it again",
  "section": "Chorus",
  "start": 34.32,
  "end": 35.56
 },
 {
  "line": "I want to hear how the bass comes in",
  "section": "Chorus",
  "start": 35.56,
  "end": 38.9
 },
 {
  "line": "Two beats late like it owns the place",
  "section": "Chorus",
  "start": 39.76,
  "end": 42.28
 },
 {
  "line": "Oh, spin it again",
  "section": "Chorus",
  "start": 42.28,
  "end": 46.54
 },
 {
  "line": "I came in here for something else",
  "section": "Chorus",
  "start": 46.54,
  "end": 49.6
 },
 {
  "line": "Now I want that sound all to myself",
  "section": "Chorus",
  "start": 49.6,
  "end": 52.68
 },
 {
  "line": "From the top, my friend",
  "section": "Chorus",
  "start": 52.68,
  "end": 55.2
 },
 {
  "line": "Spin it again",
  "section": "Chorus",
  "start": 56.42,
  "end": 58.08
 },
 {
  "line": "I take the sleeve up to the till",
  "section": "Verse",
  "start": 69.03,
  "end": 71.86
 },
 {
  "line": "The woman there is smiling still",
  "section": "Verse",
  "start": 71.86,
  "end": 74.74
 },
 {
  "line": "She taps the silver boots and says",
  "section": "Verse",
  "start": 74.74,
  "end": 77.56
 },
 {
  "line": "“That’s my brother. He still has them”",
  "section": "Verse",
  "start": 77.56,
  "end": 80.0
 },
 {
  "line": "I ask her, “Did you hear them play?”",
  "section": "Verse",
  "start": 80.0,
  "end": 82.96
 },
 {
  "line": "She leans across the counter, says,",
  "section": "Verse",
  "start": 83.16,
  "end": 85.16
 },
 {
  "line": "“Listen close when the band drops out",
  "section": "Verse",
  "start": 85.38,
  "end": 87.32
 },
 {
  "line": "That laugh you hear? That’s me”",
  "section": "Verse",
  "start": 87.44,
  "end": 90.08
 },
 {
  "line": "Two bars of keys",
  "section": "Breakdown",
  "start": 90.08,
  "end": 92.04
 },
 {
  "line": "A tap on the rim",
  "section": "Breakdown",
  "start": 92.22,
  "end": 93.42
 },
 {
  "line": "There’s her laugh",
  "section": "Breakdown",
  "start": 93.66,
  "end": 94.4
 },
 {
  "line": "Then the bass comes in",
  "section": "Breakdown",
  "start": 94.92,
  "end": 96.82
 },
 {
  "line": "She writes the date across a paper bag",
  "section": "Bridge",
  "start": 96.82,
  "end": 99.3
 },
 {
  "line": "The name of the room where they cut the track",
  "section": "Bridge",
  "start": 99.3,
  "end": 101.76
 },
 {
  "line": "I know her laugh, I know his shoes",
  "section": "Bridge",
  "start": 101.76,
  "end": 104.66
 },
 {
  "line": "And I only walked in twenty minutes ago",
  "section": "Bridge",
  "start": 104.66,
  "end": 108.66
 },
 {
  "line": "Spin it again",
  "section": "Final Chorus",
  "start": 112.26,
  "end": 113.8
 },
 {
  "line": "Now I know where the laugh comes in",
  "section": "Final Chorus",
  "start": 114.2,
  "end": 116.92
 },
 {
  "line": "One beat clear in the space they leave",
  "section": "Final Chorus",
  "start": 116.92,
  "end": 119.62
 },
 {
  "line": "Then the whole band leans back in",
  "section": "Final Chorus",
  "start": 119.62,
  "end": 123.28
 },
 {
  "line": "I came in here with a five to spend",
  "section": "Final Chorus",
  "start": 124.08,
  "end": 127.26
 },
 {
  "line": "Found a song with a story tucked in",
  "section": "Final Chorus",
  "start": 127.56,
  "end": 130.86
 },
 {
  "line": "From the top, my friend",
  "section": "Final Chorus",
  "start": 130.86,
  "end": 134.76
 },
 {
  "line": "Spin it again",
  "section": "Final Chorus",
  "start": 137.38,
  "end": 138.98
 },
 {
  "line": "Back at my place, the jacket hits the shelf",
  "section": "Outro",
  "start": 150.14,
  "end": 154.6
 },
 {
  "line": "Side B, track three",
  "section": "Outro",
  "start": 155.22,
  "end": 156.0
 },
 {
  "line": "I can find it myself",
  "section": "Outro",
  "start": 159.54,
  "end": 161.7
 }
]