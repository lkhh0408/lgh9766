[
 {
  "line": "One eye opens when your keys go click",
  "section": "Verse",
  "start": 8.62,
  "end": 12.0
 },
 {
  "line": "You’ve got one shoe on, I’m already up",
  "section": "Verse",
  "start": 12.48,
  "end": 16.3
 },
 {
  "line": "My tail taps twice on the umbrella stand",
  "section": "Verse",
  "start": 16.3,
  "end": 20.22
 },
 {
  "line": "You take the hint and set down your cup",
  "section": "Verse",
  "start": 20.22,
  "end": 23.22
 },
 {
  "line": "You check the weather, I check the breeze",
  "section": "Verse",
  "start": 23.22,
  "end": 27.84
 },
 {
  "line": "Something good’s been underneath these trees",
  "section": "Verse",
  "start": 27.84,
  "end": 31.68
 },
 {
  "line": "You’ve walked this block a thousand times",
  "section": "Verse",
  "start": 32.22,
  "end": 36.54
 },
 {
  "line": "Today I’ll show you my side",
  "section": "Verse",
  "start": 37.02,
  "end": 41.36
 },
 {
  "line": "Follow my nose",
  "section": "Chorus",
  "start": 42.1,
  "end": 43.78
 },
 {
  "line": "That’s how the morning goes",
  "section": "Chorus",
  "start": 44.18,
  "end": 48.24
 },
 {
  "line": "Left where the rosemary grows",
  "section": "Chorus",
  "start": 48.24,
  "end": 52.16
 },
 {
  "line": "Then slow, slow, slow",
  "section": "Chorus",
  "start": 53.2,
  "end": 56.0
 },
 {
  "line": "You see a gate, I smell the sea",
  "section": "Chorus",
  "start": 57.98,
  "end": 60.68
 },
 {
  "line": "On somebody’s cuffs from half past three",
  "section": "Chorus",
  "start": 60.68,
  "end": 65.64
 },
 {
  "line": "Where have they been? Nobody knows",
  "section": "Chorus",
  "start": 66.1,
  "end": 69.64
 },
 {
  "line": "Come on, follow my nose",
  "section": "Chorus",
  "start": 69.66,
  "end": 72.38
 },
 {
  "line": "Outside the bakery you say my name",
  "section": "Verse",
  "start": 74.32,
  "end": 77.6
 },
 {
  "line": "I know that voice, I know this game",
  "section": "Verse",
  "start": 77.6,
  "end": 81.86
 },
 {
  "line": "I sit so straight the baker grins",
  "section": "Verse",
  "start": 81.86,
  "end": 85.92
 },
 {
  "line": "And slips a biscuit in your hand",
  "section": "Verse",
  "start": 85.92,
  "end": 90.22
 },
 {
  "line": "But there’s a boy with grass on his knees",
  "section": "Verse",
  "start": 90.69,
  "end": 94.02
 },
 {
  "line": "And a tennis ball that smells like me",
  "section": "Verse",
  "start": 94.02,
  "end": 98.2
 },
 {
  "line": "You ask him, “Where’d you find that thing?”",
  "section": "Verse",
  "start": 98.2,
  "end": 101.86
 },
 {
  "line": "He points beneath the willow tree",
  "section": "Verse",
  "start": 103.04,
  "end": 106.5
 },
 {
  "line": "One good throw",
  "section": "Short Refrain",
  "start": 107.2,
  "end": 110.04
 },
 {
  "line": "Off I go",
  "section": "Short Refrain",
  "start": 111.2,
  "end": 113.92
 },
 {
  "line": "Straight back to you",
  "section": "Short Refrain",
  "start": 113.92,
  "end": 117.2
 },
 {
  "line": "With my morning news",
  "section": "Short Refrain",
  "start": 118.01,
  "end": 122.36
 },
 {
  "line": "Back at the door, you crouch down low",
  "section": "Bridge",
  "start": 122.36,
  "end": 126.18
 },
 {
  "line": "There’s half the park between my toes",
  "section": "Bridge",
  "start": 126.18,
  "end": 130.18
 },
 {
  "line": "You brush me off, I lick your wrist",
  "section": "Bridge",
  "start": 130.18,
  "end": 134.28
 },
 {
  "line": "You smell like rosemary, too",
  "section": "Bridge",
  "start": 134.28,
  "end": 138.44
 },
 {
