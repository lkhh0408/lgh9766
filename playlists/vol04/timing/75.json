 {
  "line": "Left the office after ten",
  "section": "Verse",
  "start": 2.7,
  "end": 6.2
 },
 {
  "line": "Snow was falling, soft and thin",
  "section": "Verse",
  "start": 6.4,
  "end": 11.8
 },
 {
  "line": "Watched my bus pull from the curb",
  "section": "Verse",
  "start": 12.5,
  "end": 16.8
 },
 {
  "line": "Took the long way, didn't say a word",
  "section": "Verse",
  "start": 17.1,
  "end": 23.6
 },
 {
  "line": "Streetlights glowing amber gold",
  "section": "Verse",
